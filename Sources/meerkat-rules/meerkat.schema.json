    "MCPLimits" : {
      "additionalProperties" : false,
      "properties" : {
        "concurrentSamples" : {
          "default" : 4,
          "description" : "events_sample and system_sample calls one MCP session runs at once",
          "maximum" : 32,
          "minimum" : 1,
          "type" : "integer"
        },
        "outputKiB" : {
          "default" : 1024,
          "description" : "Most text one MCP resource read or tool reply returns, in KiB. A longer reply is cut; events_sample instead stops adding events at it.",
          "maximum" : 16384,
          "minimum" : 16,
          "type" : "integer"
        },
        "sampleEvents" : {
          "default" : 500,
          "description" : "Most events one events_sample returns",
          "maximum" : 10000,
          "minimum" : 1,
          "type" : "integer"
        },
        "sampleSeconds" : {
          "default" : 30,
          "description" : "Longest events_sample, and longest system_sample window, in seconds",
          "maximum" : 300,
          "minimum" : 1,
          "type" : "number"
        }
      },
      "type" : "object"
    },
    "SampleStoreConfiguration" : {
      "additionalProperties" : false,
      "properties" : {
        "maxAgeDays" : {
          "default" : 30,
          "description" : "Samples older than this many days are deleted",
          "maximum" : 3650,
          "minimum" : 1,
          "type" : "integer"
        },
        "maxMegabytes" : {
          "default" : 500,
          "description" : "The store is trimmed, oldest first, past this size in MB",
          "maximum" : 100000,
          "minimum" : 10,
          "type" : "integer"
        }
      },
      "type" : "object"
    }
  },
  "$schema" : "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties" : false,
  "properties" : {
    "$schema" : {
      "description" : "The JSON Schema editors check this file against.",
      "type" : "string"
    },
    "files" : {
      "$ref" : "#/$defs/FilesConfiguration",
      "default" : {

      },
      "description" : "What file churn watches: the Files card and page, and fs.churn subscriptions without a root."
    },
    "mcp" : {
      "$ref" : "#/$defs/MCPConfiguration",
      "default" : {

      },
      "description" : "What MCP clients (`meerkat mcp`) may sample, and how much."
    },
    "samples" : {
      "$ref" : "#/$defs/SampleStoreConfiguration",
      "default" : {

      },
      "description" : "The sample store's budget (samples.db)."
    }
  },
