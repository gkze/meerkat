        "exclude" : {
          "default" : [
            "/private/var/folders",
            "/private/var/db",
            "/.Spotlight-V100",
            "/.fseventsd"
          ],
          "description" : "Paths under root whose changes are not counted, absolute or starting with ~. Replaces the default list.",
          "items" : {
            "type" : "string"
          },
          "type" : "array"
        },
        "root" : {
          "default" : "/",
          "description" : "Directory file churn watches, absolute or starting with ~; by default the whole startup volume.",
          "type" : "string"
        }
      },
      "type" : "object"
    },
