+
+/// An embedded lazy file's source, written under the build script's OUT_DIR
+/// for it to transpile into the residual tables as it does a file on disk.
+fn embedded_lazy_file(specifier: &str, code: &str) -> PathBuf {
+  let dir = PathBuf::from(std::env::var_os("OUT_DIR").unwrap()).join("embedded_lazy_sources");
+  std::fs::create_dir_all(&dir).unwrap();
+  let name: String = specifier
+    .chars()
+    .map(|c| if c.is_ascii_alphanumeric() || c == '.' { c } else { '_' })
+    .collect();
+  let path = dir.join(name);
+  std::fs::write(&path, code).unwrap();
+  path
+}
