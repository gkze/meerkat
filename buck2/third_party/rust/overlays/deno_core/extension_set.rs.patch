+/// Whether a snapshotted extension's lazy file is left to the residual table:
+/// one only on the build machine's disk, as upstream, and one embedded in the
+/// binary, which deno_runtime's overlaid snapshot.rs puts in that table
+/// already transpiled, so a worker need not transpile it again as it starts.
+fn skip_snapshotted_lazy(file: &ExtensionFileSource) -> bool {
+  #[allow(deprecated, reason = "matching deprecated variant we still inspect")]
+  let embedded = matches!(file.code, crate::ExtensionFileSourceCode::IncludedInBinary(_));
+  !file.is_runtime_loadable() || embedded
 }
