spm_pins_test(
    name = "pins_test",
    revisions = {name: package["revision"] for name, package in PACKAGES.items()},
)

# What a package's manifest does not say about a binary target. Every grammar
# CodeEditLanguages knows, prebuilt by CodeEdit as one static framework
# (CodeLanguages-Container in that repository).
BINARIES = {
    "CodeLanguagesContainer": {
        "framework": "CodeLanguages_Container",
        "library": "CodeLanguagesContainer.xcframework/macos-arm64_x86_64",
    },
}

# modules.bzl's tables: TRAITS, what each package builds with, its default
# traits, as nothing here asks for others (SwiftPM makes each a compilation
# condition of the package's targets); MINIMUM_MACOS, each package's manifest's
# macOS minimum, else SwiftPM's default (10.13); and MODULES, each package
# target modules build, with its manifest's settings: the module's directory
# (`path`), its kind (library, macro, system library or C), dependencies (`deps`
# modules, `macros` plugins), `defines`, upcoming and experimental features,
# other `swift_flags`, `exclude`, and `language_mode` where it is not 6. A C
# target has its sources, and its package's own module map in include/.
modules = {name: module | BINARIES.get(name, {}) for name, module in MODULES.items()}

spm_packages(PACKAGES, modules)

spm_modules(modules, traits = TRAITS, minimum_macos = MINIMUM_MACOS)

ARCHIVES = {name: ":" + name for name in PACKAGES}

spm_manifest_test(
    name = "manifest_test",
    archives = ARCHIVES,
)

spm_tables(
    name = "regenerate",
    archives = ARCHIVES,
    visibility = ["PUBLIC"],
)
