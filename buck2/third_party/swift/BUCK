# The Swift packages Package.swift depends on, and theirs, built from source
# as SwiftPM builds them (see defs.bzl): only the targets this repository
# uses and their dependencies. PACKAGES here pins them; modules.bzl is
# generated from each package's manifest at its pin (`swift package
# dump-package`). After changing a pin, `buck2 run :regenerate` rewrites it, and
# :manifest_test fails while it is stale.
#
# Not built: the packages' resources. GRDB and swift-sharing ship only a
# PrivacyInfo.xcprivacy, which no code reads (no `Bundle.module`) and which
# matters only to App Store submission.

load("//buck2/rules:conformance.bzl", "spm_manifest_test", "spm_pins_test", "spm_tables")
load(":defs.bzl", "spm_modules", "spm_packages")
load(":modules.bzl", "MINIMUM_MACOS", "MODULES", "TRAITS")

