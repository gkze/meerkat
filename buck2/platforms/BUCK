load(":defs.bzl", "execution_platform")

# Target platforms: the host (macOS on Apple silicon, or Linux on arm64 for
# the `portable` checks, from the prelude's host detection) in each build
# mode.
[
    platform(
        name = mode,
        constraint_values = ["//buck2/config:mode[{}]".format(mode)],
        deps = ["prelude//platforms:default"],
        visibility = ["PUBLIC"],
    )
    for mode in ["debug", "release"]
]

# Build tools — Swift macro plugins and the swift-syntax they link, Rust
# build scripts and proc macros — always build optimized, whatever the
# targets' mode: the compiler runs macro plugins on every expansion, and
# swift-syntax unoptimized makes that many times slower (SwiftPM uses a
# prebuilt release swift-syntax for the same reason). One build of each
# serves debug and release targets alike.
execution_platform(
    name = "exec",
    platform = ":release",
    visibility = ["PUBLIC"],
)

# The hosts the pinned tools (buck2/third_party/tools) have an executable
# for, which their downloads select on: macOS, where everything builds, and
# Linux, which runs the `portable` checks (.github/workflows/ci.yml).
[
    config_setting(
        name = "{}-arm64".format(os),
        constraint_values = [
            "prelude//os/constraints:os[{}]".format(os),
            "prelude//cpu/constraints:cpu[arm64]",
        ],
        visibility = ["PUBLIC"],
    )
    for os in ["macos", "linux"]
]
