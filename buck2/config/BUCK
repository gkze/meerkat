# The one build-mode axis. Toolchains select on it: debug compiles quickly
# with assertions and `-enable-testing` (what `swift build` and `cargo build`
# default to); release optimizes, as `swift build -c release` and
# `cargo build --release` do.
constraint(
    name = "mode",
    default = "debug",
    values = ["debug", "release"],
    visibility = ["PUBLIC"],
)

# Where an action may run once remote execution is on: anywhere, or only on
# the Mac running Buck (buck2/platforms/defs.bzl, LOCAL_EXECUTION).
constraint(
    name = "execution",
    default = "anywhere",
    values = ["anywhere", "local"],
    visibility = ["PUBLIC"],
)
