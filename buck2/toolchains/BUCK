# Toolchains, all from the host: Xcode (Swift, clang, the SDK), rustup's
# Rust, and Python for the prelude's own build helpers. Versions are pinned
# where they are chosen and are part of the actions' keys: Xcode by
# `[swift] xcode_build` (checked by //buck2/rules/swift:xcode_test), Rust by
# `[rust] release` (//buck2/rules:rust_test); see buck2/rules/toolchains.bzl.

load("@prelude//tests:test_toolchain.bzl", "noop_test_toolchain")
load("@prelude//toolchains:cxx.bzl", "cxx_tools_info_toolchain")
load("@prelude//toolchains:genrule.bzl", "system_genrule_toolchain")
load("@prelude//toolchains:python.bzl", "system_python_bootstrap_toolchain", "system_python_toolchain")
load("@prelude//toolchains:remote_test_execution.bzl", "remote_test_execution_toolchain")
load("@root//buck2/rules:toolchains.bzl", "rustup_toolchain", "xcode_clang_tools")
load("@root//buck2/rules/swift:toolchain.bzl", "swift_toolchain")

DEVELOPER_DIR = read_root_config("swift", "developer_dir", "/Applications/Xcode.app/Contents/Developer")

MINIMUM_MACOS = read_root_config("meerkat", "minimum_macos")

XCODE_BUILD = read_root_config("swift", "xcode_build", "")

# Build tools (//buck2/platforms:exec) have no debug info: they only run during
# a build, and it is most of what a build script linking Deno weighs. Meerkat's
# own tools have it in their debug and release builds.
BUILD_TOOL = "prelude//cfg/exec_platform/marker:is_exec_platform[true]"

# Xcode's clang, clang++ and ar, for C, C++ and every link of a Rust binary.
xcode_clang_tools(
    name = "xcode_clang",
    developer_dir = DEVELOPER_DIR,
    xcode_build = XCODE_BUILD,
)

# The prelude's generic toolchain from `cxx_tools_info`. Its platform name is
# not the host's, which only `platform_*` attributes match on, and no BUCK
# file here uses them.
cxx_tools_info_toolchain(
    name = "cxx",
    cxx_tools_info = ":xcode_clang",
    # Package.swift's `platforms: [.macOS(.v27)]`.
    c_flags = ["-mmacosx-version-min=" + MINIMUM_MACOS],
    cxx_flags = ["-mmacosx-version-min=" + MINIMUM_MACOS],
    link_flags = ["-mmacosx-version-min=" + MINIMUM_MACOS],
    link_style = "static",
    visibility = ["PUBLIC"],
)

swift_toolchain(
    name = "swift",
    compile_flags = select({
        # Debug compiles a module's files as parallel jobs, as `swift build`
        # does; release optimizes the whole module at once. Not
        # `-enable-batch-mode`: with it, Xcode 27.1's driver named the objects
        # of an executable differently from what it linked.
        "root//buck2/config:mode[debug]": ["-Onone", "-g", "-enable-testing", "-DDEBUG"],
        "root//buck2/config:mode[release]": ["-O", "-wmo"] + select({
            "DEFAULT": ["-g"],
            BUILD_TOOL: [],
        }),
    }),
    developer_dir = DEVELOPER_DIR,
    minimum_os = MINIMUM_MACOS,
    module_cache = "buck-out/swift-module-cache",
    xcode_build = XCODE_BUILD,
    visibility = ["PUBLIC"],
)

rustup_toolchain(
    name = "rust",
    release = read_root_config("rust", "release"),
    default_edition = "2024",
    # Stable-only, as Cargo builds: no RUSTC_BOOTSTRAP, so dependents link
    # against each crate's full rlib rather than a separately compiled
    # `-Zno-codegen` rmeta. The two compiles of a crate can disagree (askama's
    # derive in uniffi_bindgen does), which fails dependents with "found
    # possibly newer version of crate".
    nightly_features = False,
    rustc_flags = select({
        # Cargo's dev profile. The explicit opt-level is also how build
        # scripts get OPT_LEVEL, which Cargo always sets.
        "root//buck2/config:mode[debug]": ["-Copt-level=0", "-Cdebuginfo=line-tables-only"],
        # Cargo's release profile, keeping line tables as Swift's release
        # keeps `-g`, except in build tools (BUILD_TOOL).
        "root//buck2/config:mode[release]": ["-Copt-level=3"] + select({
            "DEFAULT": ["-Cdebuginfo=line-tables-only"],
            BUILD_TOOL: [],
        }),
    }) + [
        # As Cargo passes without LTO: machine code only. Embedded bitcode
        # from rustc's LLVM is unreadable to Xcode's tools (nm, ld's LTO).
        "-Cembed-bitcode=no",
    ],
    visibility = ["PUBLIC"],
)

system_python_toolchain(
    name = "python",
    visibility = ["PUBLIC"],
)

system_python_bootstrap_toolchain(
    name = "python_bootstrap",
    visibility = ["PUBLIC"],
)

system_genrule_toolchain(
    name = "genrule",
    visibility = ["PUBLIC"],
)

noop_test_toolchain(
    name = "test",
    visibility = ["PUBLIC"],
)

remote_test_execution_toolchain(
    name = "remote_test_execution",
    visibility = ["PUBLIC"],
)
