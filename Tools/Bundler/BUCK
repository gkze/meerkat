load("//buck2/rules:bundle.bzl", "bundle_command", "directory")
load("//buck2/rules:check.bzl", "XCODE_ENV", "checked_in_copy")
load("//buck2/rules:meerkat.bzl", "meerkat_swift_binary")
load("//buck2/third_party/js:defs.bzl", "js_tool_target")
load(":parts.bzl", "PARTS")

# Assembles, signs and installs Meerkat.app from the parts below.
meerkat_swift_binary(
    name = "bundle",
    srcs = ["Bundler.swift"],
    deps = [
        "//Sources/MeerkatIPC:MeerkatIPC",
        "//Sources/MeerkatKit:MeerkatKit",
        "//Sources/MeerkatRules:MeerkatRules",
        "//Tools/ReleaseVersion:ReleaseVersion",
        "//Tools/ToolProcess:ToolProcess",
        "//buck2/third_party/swift:ArgumentParser",
    ],
)

# Every bundle carries the release version and macOS .buckconfig declares,
# and its icon is compiled by the Xcode Buck builds with.
_COMMON = {
    "bundler": ":bundle",
    "developer_dir": read_root_config("swift", "developer_dir"),
    "minimum_macos": read_root_config("meerkat", "minimum_macos"),
    "version": read_root_config("meerkat", "version"),
}

# Contents/Resources/lint/, in the layout LintToolchain reads: the linters
# and formatter, the meerkat/* rules and the policy every rules folder
# extends. The daemon tests run against it too.
directory(
    name = "lint-toolchain",
    entries = {
        "bin/meerkat-lint": "//Sources/meerkat-lint:meerkat-lint",
        "bin/oxfmt": js_tool_target("oxfmt"),
        "bin/oxlint": js_tool_target("oxlint"),
        "bin/tsrslint": js_tool_target("tsrslint"),
        "policy/oxfmtrc.json": "//Sources/meerkat-lint:oxfmtrc",
        "policy/oxlintrc.json": "//Sources/meerkat-lint:oxlintrc",
    },
    visibility = ["PUBLIC"],
)

_FULL = PARTS | _COMMON | {
    # meerkatd compiles the checked-in bindings; ones that do not match the
    # library it links fail UniFFI's checksum check at its first runtime
    # call, and an installed daemon would crash-loop under launchd.
    "checks": ["//Sources/meerkat-runtime/bindgen:bindings_current"],
    # Generated from the parts, so not itself a part: the file in the bundle
    # always matches what the bundle holds.
    "notices": "//Tools/Notices:notices",
}

# build/Meerkat.app, always optimized (a debug V8 embedding is many times
# slower): `buck2 run //Tools/Bundler:app [-- --install]`.
bundle_command(
    name = "app",
    mode = "release",
    **_FULL
)

# The same bundle from a debug build, which honours MEERKAT_SAMPLE_DATA.
bundle_command(
    name = "app-debug",
    mode = "debug",
    **_FULL
)

# build/Meerkat Preview.app: the app alone under its own identifier, to run
# beside the installed one (no daemon, CLI or agent).
bundle_command(
    name = "preview",
    app = PARTS["app"],
    mode = "debug",
    preview = True,
    **_COMMON
)

# docs/images/meerkat-icon.png, the icon the README shows: AppIcon.icon
# compiled as the bundler compiles it, and the 256-pixel image (128 points at
# 2x) of the AppIcon.icns that writes, as stored there. actool exits 0 even
# when it compiles nothing, so a missing AppIcon.icns is the failure, with its
# report. A genrule's sources are links, which actool refuses, so it compiles
# a copy. Its icns is the same bytes on every run (Assets.car is not), so the
# check compares bytes. XCODE_ENV keys it on the Xcode's build, as every Swift
# action is, so a new Xcode renders it again.
genrule(
    name = "readme-icon",
    srcs = glob(["AppIcon.icon/**"]),
    out = "meerkat-icon.png",
    env = XCODE_ENV,
    cmd = """
    cp -RL "$SRCDIR/AppIcon.icon" "$TMP/AppIcon.icon" &&
    /usr/bin/xcrun actool "$TMP/AppIcon.icon" --compile "$TMP" \
        --platform macosx --target-device mac --minimum-deployment-target {} \
        --app-icon AppIcon --include-all-app-icons \
        --output-partial-info-plist "$TMP/partial.plist" --errors --warnings > "$TMP/report" &&
    if [ ! -f "$TMP/AppIcon.icns" ]; then cat "$TMP/report" >&2; exit 1; fi &&
    /usr/bin/iconutil --convert iconset --output "$TMP/AppIcon.iconset" "$TMP/AppIcon.icns" &&
    cp "$TMP/AppIcon.iconset/icon_128x128@2x.png" "$OUT"
    """.format(read_root_config("meerkat", "minimum_macos")),
)

checked_in_copy(
    test = "icon_test",
    generated = "$(location :readme-icon)",
    path = "docs/images/meerkat-icon.png",
)
