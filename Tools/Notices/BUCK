# A shipped download whose license comes from elsewhere here (PREBUILT).
COVERED = ["buck2/third_party/rust/fixups/v8:librusty_v8.a.gz"]

# The prebuilt Rust programs (//buck2/third_party/js) list the crates the
# Cargo.lock of their release locks: the commit the release tag names,
# pinned by hash. `tracks` is each shipped package the lockfile is for, so
# the tool fails when one moves without its lockfile. bundled_crates.bzl,
# generated from these (`buck2 run :regenerate`), downloads the crates.io
# packages, and the tool fails while it is stale. A Git source must be in
# PREBUILT.
LOCKFILES = {
    "oxc": dict(
        programs = "Oxlint and Oxfmt",
        tracks = ["oxlint@1.90.0", "oxfmt@0.75.0"],
        url = "https://raw.githubusercontent.com/oxc-project/oxc/9b6fff42fa6edf0bec55861b6f0764c7b9acd86b/Cargo.lock",
        sha256 = "ff21cbf960d0f7678b4b9e95385dd0f4695db492b3155e017a76e0f8b5ecb82f",
    ),
    "tsrs": dict(
        programs = "tsrs",
        tracks = ["@tsrs/darwin-arm64@0.20.1-ts7.1.0-beta"],
        url = "https://raw.githubusercontent.com/oxc-project/tsrs/77d3cddb44540734abc33a42ccca4d3f33bee527/Cargo.lock",
        sha256 = "e51697e71d474c6c7ecf410b53d16b7e33bf9d55d96447beaed3af732a4a5e7d",
    ),
    "tsrslint": dict(
        programs = "tsrslint",
        tracks = ["@maschwenk/tsrslint-darwin-arm64@0.1.6"],
        url = "https://raw.githubusercontent.com/maschwenk/tsrslint/7cec06124f4e53749c06e9669cf7d6531c2f772b/Cargo.lock",
        sha256 = "660187af4a267b3e7c1d180a5f8bc9e2551c7803c959538c865d47bd7055c7f7",
    ),
}

[
    http_file(name = name + ".Cargo.lock", urls = [lockfile["url"]], sha256 = lockfile["sha256"])
    for name, lockfile in LOCKFILES.items()
]

[
    http_archive(
        name = "{}.crate".format(key.replace("@", "-")),
        urls = ["https://static.crates.io/crates/{0}/{1}/download".format(*key.split("@"))],
        sha256 = sha256,
        strip_prefix = key.replace("@", "-"),
        type = "tar.gz",
    )
    for key, sha256 in BUNDLED_CRATES.items()
]

# `buck2 run` it (or //:fix) to rewrite bundled_crates.bzl from LOCKFILES.
command(
    name = "regenerate",
    command = ["$(exe :tool)", "bundled-crates", "Tools/Notices/bundled_crates.bzl"] + [
        "$(location :{}.Cargo.lock)".format(name)
        for name in LOCKFILES
    ],
    visibility = ["PUBLIC"],
)

# Components that ship although their license is not one deny.toml's
# `[licenses] allow` lists, or not one Tools/Notices can name, by
# `name@version`, each with the reviewed reason. An entry no component needs
# fails the build, so none outlives its reason. Keep this list short.
EXCEPTIONS = {
    # Neither publishes a license at any revision (no LICENSE, none in the
    # README, none GitHub detects; upstream issues CodeEditLanguages#93, #94,
    # #96 and CodeEditSymbols#23, #24 ask for one). They ship as they are, by
    # decision (docs/design/rule-editor.md, "Licences"); a new version is
    # reviewed again, since an exception names one version.
    "codeeditlanguages@0.1.20": "No license published upstream; shipped as is by decision (docs/design/rule-editor.md, Licences).",
    "codeeditsymbols@0.2.3": "No license published upstream; shipped as is by decision (docs/design/rule-editor.md, Licences).",
}

third_party_notices(
    name = "notices",
    # The closure of the bundle's parts over target dependencies only, which
    # leaves out build scripts and macros (exec dependencies).
    shipped = """
        kind('http_archive|http_file|_unpack',
            deps(set({}), 2147483647, target_deps()))
    """.format(" ".join(PARTS.values())),
    npm = {
        "tsrs": ("//buck2/third_party/js:tsrs", ""),
        "tsrslint": ("//buck2/third_party/js:tsrslint", ""),
        "oxfmt": (
            "//buck2/third_party/js:oxfmt-npm",
            "Bundled as Oxc's prebuilt release; its npm package of the same version gives the license. Its crates are under Rust crates.",
        ),
        "oxlint": (
            "//buck2/third_party/js:oxlint-npm",
            "Bundled as Oxc's prebuilt release; its npm package of the same version gives the license. Its crates are under Rust crates.",
        ),
    },
    lockfiles = [
        (lockfile["programs"], lockfile["tracks"], ":{}.Cargo.lock".format(name))
        for name, lockfile in LOCKFILES.items()
    ],
    bundled = {key: ":{}.crate".format(key.replace("@", "-")) for key in BUNDLED_CRATES},
    policy = "//buck2/third_party/rust/check:deny.toml",
    exceptions = EXCEPTIONS,
    # Compiled into the runtime and bundled as deno.d.ts; Deno is under PREBUILT.
    covered = COVERED + ["Sources/meerkat-runtime:" + library for library in DENO_LIBRARIES],
    grammars = [
        (dict(repository = repository, revision = revision), fetched_texts(repository + "-" + revision[:12], {
            file: ("https://raw.githubusercontent.com/{}/{}/{}".format(repository, revision, file), sha256)
            for file, sha256 in files.items()
        }))
        for repository, revision, files in GRAMMARS
    ],
    prebuilt = [
        (
            {key: value for key, value in component.items() if key != "files"},
            fetched_texts(component["name"], component["files"]),
        )
        for component in PREBUILT
    ],
    resolved = "//:Package.resolved",
    standard = {
        name: fetched_texts("spdx-" + name, {
            name: ("https://raw.githubusercontent.com/spdx/license-list-data/{}/text/{}.txt".format(SPDX_RELEASE, name), sha256),
        })[name]
        for name, sha256 in STANDARD.items()
    },
    tool = ":tool",
    visibility = ["PUBLIC"],
)
