    ("tree-sitter-grammars/tree-sitter-zig", "eb7d58c2dc4fbeea4745019dee8df013034ae66b", {"LICENSE": "0eea8dc45e89deeb03c7799bbbc7b4688f365fb274562f4540ecfebdea82e727"}),
